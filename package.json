{
  "name": "@yannelli/paseo-prompt-manager",
  "type": "module",
  "version": "0.4.2",
  "description": "Markdown prompt library for Paseo with local version history, imports, and optional Git sync",
  "license": "MIT",
  "author": "Ryan Yannelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannelli/paseo-prompt-manager.git"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!server/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test server/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "release:dry-run": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.0-beta.3",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
